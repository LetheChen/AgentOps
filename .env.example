# AgentOps 环境变量配置示例
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已在 .gitignore 中，不会进 git

# ── 企业微信推送（log_analyst 告警必填）──────────────────────
# 企业微信群机器人 Webhook URL（log_analyst 发现重大问题时推送）
# 获取方式：企业微信群 → 群设置 → 群机器人 → 添加机器人 → 复制 Webhook 地址
WECOM_WEBHOOK_URL=

# ── 日志巡检 ──────────────────────────────────────────────
# 日志根目录（patrol.yaml 无配置时回退用，默认 ./logs/）
# 生产部署建议改为 /var/log/agentops_sources/
LOG_PATROL_DIR=./logs/

# ── MiniMax（local_llm / codex_appserver harness 用）─────────
# MiniMax API Key（local_llm harness + codex_appserver 直连用）
MINIMAX_API_KEY=
# MiniMax API Base URL（默认 https://api.minimaxi.com/v1）
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# MiniMax 默认模型（默认 MiniMax-M3）
MINIMAX_MODEL=MiniMax-M3

# ── OpenAI（title_generator / 兼容 provider 用）──────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ── opencode server（opencode harness 用）────────────────────
# opencode serve 启动的 host 和 port（默认 127.0.0.1:4096）
OPENCODE_HOST=127.0.0.1
OPENCODE_PORT=4096

# ── vLLM（本地/内网推理服务，可选）────────────────────────
# vLLM OpenAI 兼容端点（必须含 /v1 后缀；形如 http://10.0.0.1:8000/v1）
VLLM_BASE_URL=
# vLLM API Key（本地 vLLM 通常为空或 dummy）
VLLM_API_KEY=
